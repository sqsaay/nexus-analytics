# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database Connection (PostgreSQL or SQLite)
# For local zero-config SQLite: file:./dev.db
# For PostgreSQL (Render / Neon / Supabase): postgresql://user:password@localhost:5432/nexus_db?schema=public
DATABASE_URL="file:./dev.db"

# JWT Security Secrets
JWT_SECRET="nexus_jwt_access_secret_2026_key"
JWT_REFRESH_SECRET="nexus_jwt_refresh_secret_2026_key"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Third-Party Integrations
GEMINI_API_KEY="" # Optional: Leaves graceful fallback active if left empty
COINGECKO_API_KEY="" # Optional: Public endpoint used if left empty
